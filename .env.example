# URL of the Express API. The Next.js server proxies /api and /uploads to it,
# so the browser always talks to the client origin (cookies stay first-party).
API_PROXY_URL=http://localhost:5000

# Optional absolute API URL used by browser code instead of the /api proxy.
# Leave blank to use the proxy (recommended).
NEXT_PUBLIC_API_URL=

# Public site URL used for metadata and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
